{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.test -- jest --testPathIgnorePatterns=integration",
    "test:unit": "npm run typecheck && dotenv -e .env.test -- jest --testPathIgnorePatterns=integration",
    "test:int": "npm run typecheck && NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" dotenv -e .env.test --  jest integration",
    "test:watch": "dotenv -e .env.test -- jest --watch --testPathIgnorePatterns=integration",
    "test:coverage": "dotenv -e .env.test -- jest --coverage",
    "start": "node dist/server.js",
    "build": "tsc",
    "start:dev": "nodemon --ext ts,json --exec node src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "nock": "^15.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  }
}
